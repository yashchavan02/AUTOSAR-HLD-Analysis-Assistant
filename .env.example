# Copy to .env and fill in. .env is git-ignored - never commit real keys.
# Existing shell environment variables always win over this file.

# --- LLM provider -------------------------------------------------------
# groq | openai | ollama | custom
HLD_LLM_PROVIDER=groq

# Groq: key from https://console.groq.com/keys  (picked up automatically)
GROQ_API_KEY=your-groq-api-key-here

# Optional overrides (defaults come from the provider preset)
#HLD_LLM_MODEL=openai/gpt-oss-120b
#HLD_LLM_BASE_URL=https://api.groq.com/openai/v1
#HLD_LLM_API_KEY=
#HLD_LLM_TIMEOUT=90
#HLD_LLM_ENABLED=1

# --- OpenAI example -----------------------------------------------------
#HLD_LLM_PROVIDER=openai
#OPENAI_API_KEY=sk-...

# --- Ollama / private OpenAI-compatible endpoint -------------------------
#HLD_LLM_PROVIDER=custom
#HLD_LLM_BASE_URL=http://localhost:11434/v1
#HLD_LLM_MODEL=llama3.2
#HLD_LLM_API_KEY=not-needed

# --- Embeddings -----------------------------------------------------------
#HLD_EMBEDDER=auto              # auto | fastembed | sentence-transformers | hashing
#HLD_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Storage / retrieval ---------------------------------------------------
#HLD_DATA_DIR=data
#HLD_TOP_K=6
#HLD_PROJECT=default




